local flingActive = false
local flingConn = nil
addToggle(playersPage, "Touch Fling", function(on)
	flingActive = on
	local char = LP.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	
	if flingActive then
		local spin = Instance.new("AngularVelocity", root)
		spin.Name = "FlingSpin"
		spin.AngularVelocity = Vector3.new(0, 99999, 0)
		spin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		spin.P = math.huge
		
		flingConn = root.Touched:Connect(function(hit)
			if not flingActive then return end
			local hitChar = hit.Parent
			if hitChar and hitChar ~= char and hitChar:FindFirstChild("HumanoidRootPart") then
				local hitRoot = hitChar:FindFirstChild("HumanoidRootPart")
				local bv = Instance.new("BodyVelocity", hitRoot)
				bv.Velocity = Vector3.new(0, 50000, 0)
				bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				game:GetService("Debris"):AddItem(bv, 1)
			end
		end)
	else
		local spin = root:FindFirstChild("FlingSpin")
		if spin then spin:Destroy() end
		if flingConn then flingConn:Disconnect() flingConn = nil end
	end
end)

-- Респавн для флинга
LP.CharacterAdded:Connect(function()
	if flingActive then task.wait(1) 
		local char = LP.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local spin = Instance.new("AngularVelocity", char.HumanoidRootPart)
			spin.Name = "FlingSpin"
			spin.AngularVelocity = Vector3.new(0, 99999, 0)
			spin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		end
	end
end)

print("Универсал: Часть 2 загружена. Touch Fling в Players.")
