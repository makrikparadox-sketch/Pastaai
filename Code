-- ================= MOVEMENT (FLY FIX) =================
local flying = false
local flySpeed = 50

local flyBtn = Instance.new("TextButton", movementPage)
flyBtn.Size = UDim2.new(1, 0, 0, 40)
flyBtn.BackgroundColor3 = Color3.fromRGB(30, 45, 70)
flyBtn.Text = "Fly: OFF"
flyBtn.TextColor3 = Color3.new(1, 1, 1)
flyBtn.Position = UDim2.fromOffset(0, 0)
Instance.new("UICorner", flyBtn).CornerRadius = UDim.new(0, 6)

local speedLabel = Instance.new("TextLabel", movementPage)
speedLabel.Size = UDim2.new(1, 0, 0, 20)
speedLabel.Position = UDim2.fromOffset(0, 50)
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "Скорость: 50"
speedLabel.TextColor3 = Color3.new(1, 1, 1)

local speedSlider = Instance.new("TextButton", movementPage)
speedSlider.Size = UDim2.new(1, 0, 0, 20)
speedSlider.BackgroundColor3 = Color3.fromRGB(30, 45, 70)
speedSlider.Text = ""
speedSlider.Position = UDim2.fromOffset(0, 80)
Instance.new("UICorner", speedSlider).CornerRadius = UDim.new(1, 0)

local sliderFill = Instance.new("Frame", speedSlider)
sliderFill.Size = UDim2.new(0.2, 0, 1, 0)
sliderFill.BackgroundColor3 = Color3.fromRGB(110, 190, 255)
Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

local sliding = false
local function updateSlider(input)
	local rel = math.clamp((input.Position.X - speedSlider.AbsolutePosition.X) / speedSlider.AbsoluteSize.X, 0, 1)
	flySpeed = math.floor(10 + rel * 190)
	sliderFill.Size = UDim2.new(rel, 0, 1, 0)
	speedLabel.Text = "Скорость: " .. flySpeed
end
speedSlider.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then sliding = true updateSlider(i) end end)
UIS.InputChanged:Connect(function(i) if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then updateSlider(i) end end)
UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then sliding = false end end)

flyBtn.MouseButton1Click:Connect(function()
	flying = not flying
	flyBtn.Text = flying and "Fly: ON" or "Fly: OFF"
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end

	if flying then
		hum.PlatformStand = true
		local bv = Instance.new("BodyVelocity", root)
		bv.Name = "FlyVel"
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		
		-- Гироскоп для Shift Lock
		local bg = Instance.new("BodyGyro", root)
		bg.Name = "FlyGyro"
		bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bg.P = 10000
		
		-- Отслеживаем кнопки для ПК
		local keyMove = {f=0, b=0, l=0, r=0, up=0, down=0}
		UIS.InputBegan:Connect(function(i, g)
			if g then return end
			if i.KeyCode == Enum.KeyCode.W then keyMove.f = 1 end
			if i.KeyCode == Enum.KeyCode.S then keyMove.b = -1 end
			if i.KeyCode == Enum.KeyCode.A then keyMove.l = -1 end
			if i.KeyCode == Enum.KeyCode.D then keyMove.r = 1 end
			if i.KeyCode == Enum.KeyCode.Space then keyMove.up = 1 end
			if i.KeyCode == Enum.KeyCode.LeftShift then keyMove.down = -1 end
		end)
		UIS.InputEnded:Connect(function(i)
			if i.KeyCode == Enum.KeyCode.W then keyMove.f = 0 end
			if i.KeyCode == Enum.KeyCode.S then keyMove.b = 0 end
			if i.KeyCode == Enum.KeyCode.A then keyMove.l = 0 end
			if i.KeyCode == Enum.KeyCode.D then keyMove.r = 0 end
			if i.KeyCode == Enum.KeyCode.Space then keyMove.up = 0 end
			if i.KeyCode == Enum.KeyCode.LeftShift then keyMove.down = 0 end
		end)

		task.spawn(function()
			while flying and char.Parent do
				RunService.RenderStepped:Wait()
				
				local camCF = workspace.CurrentCamera.CFrame
				
				-- Принудительный поворот (Shift Lock)
				bg.CFrame = CFrame.new(root.Position, root.Position + camCF.LookVector)
				
				-- Берем направление с джойстика (MoveDirection), но применяем его только если есть ввод
				local moveDir = hum.MoveDirection
				local finalDir = Vector3.new(0, 0, 0)
				
				if moveDir.Magnitude > 0 then
					-- Джойстик двигает относительно камеры
					local forward = camCF.LookVector * (moveDir.Z * -1) 
					local right = camCF.RightVector * moveDir.X
					finalDir = (forward + right).Unit * flySpeed
				else
					-- Если джойстика нет, используем кнопки (для ПК)
					local forward = camCF.LookVector * keyMove.f
					local backward = camCF.LookVector * keyMove.b
					local left = camCF.RightVector * keyMove.l
					local right = camCF.RightVector * keyMove.r
					local up = Vector3.new(0, 1, 0) * keyMove.up
					local down = Vector3.new(0, 1, 0) * keyMove.down
					
					local manualDir = forward + backward + left + right + up + down
					if manualDir.Magnitude > 0 then
						finalDir = manualDir.Unit * flySpeed
					end
				end
				
				bv.Velocity = finalDir
			end
		end)
	else
		hum.PlatformStand = false
		local bv = root:FindFirstChild("FlyVel")
		if bv then bv:Destroy() end
		local bg = root:FindFirstChild("FlyGyro")
		if bg then bg:Destroy() end
	end
end)
