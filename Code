local function addToggle(page, text, callback)
	local btn = Instance.new("TextButton", page)
	btn.Size = UDim2.new(1, 0, 0, 35)
	btn.BackgroundColor3 = Color3.fromRGB(30, 45, 70)
	btn.Text = text .. ": OFF"
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	corner(btn, UDim.new(0, 6))
	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = text .. (state and ": ON" or ": OFF")
		if callback then task.spawn(callback, state) end
	end)
end

local function addSlider(page, text, min, max, default, callback)
	local row = Instance.new("Frame", page)
	row.Size = UDim2.new(1, 0, 0, 45)
	row.BackgroundColor3 = Color3.fromRGB(30, 45, 70)
	corner(row, UDim.new(0, 6))
	local lbl = Instance.new("TextLabel", row)
	lbl.Size = UDim2.new(1, -20, 0, 20)
	lbl.Position = UDim2.fromOffset(10, 2)
	lbl.BackgroundTransparency = 1
	lbl.Text = text .. ": " .. default
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	local track = Instance.new("Frame", row)
	track.Size = UDim2.new(1, -20, 0, 6)
	track.Position = UDim2.fromOffset(10, 28)
	track.BackgroundColor3 = Color3.fromRGB(70, 85, 120)
	corner(track, UDim.new(1, 0))
	local fill = Instance.new("Frame", track)
	fill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
	fill.BackgroundColor3 = ACCENT
	corner(fill, UDim.new(1, 0))
	local hit = Instance.new("TextButton", row)
	hit.Size = UDim2.new(1, 0, 0, 20)
	hit.Position = UDim2.fromOffset(0, 20)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	local sliding = false
	local function update(i)
		local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local val = math.floor(min + rel * (max - min))
		fill.Size = UDim2.new(rel, 0, 1, 0)
		lbl.Text = text .. ": " .. val
		if callback then task.spawn(callback, val) end
	end
	hit.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then sliding = true update(i) end end)
	UIS.InputChanged:Connect(function(i) if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i) end end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then sliding = false end end)
end

