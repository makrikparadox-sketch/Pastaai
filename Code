	-- ПОЛЁТ
	local flying = false
	addToggle(combat, "Fly (Полёт)", function(on)
		flying = on
		local plr = LP
		local char = plr.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
		if not hum or not torso then return end

		if not flying then
			hum.PlatformStand = false
			if char:FindFirstChild("Animate") then char.Animate.Disabled = false end
			local bg = torso:FindFirstChild("FlyGyro")
			local bv = torso:FindFirstChild("FlyVel")
			if bg then bg:Destroy() end
			if bv then bv:Destroy() end
			hum:ChangeState(Enum.HumanoidStateType.Running)
		else
			hum.PlatformStand = true
			if char:FindFirstChild("Animate") then char.Animate.Disabled = true end

			local bg = Instance.new("BodyGyro", torso)
			bg.Name = "FlyGyro"
			bg.P = 9e4
			bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
			bg.cframe = torso.CFrame

			local bv = Instance.new("BodyVelocity", torso)
			bv.Name = "FlyVel"
			bv.velocity = Vector3.new(0, 0.1, 0)
			bv.maxForce = Vector3.new(9e9, 9e9, 9e9)

			local speed = 0
			local maxspeed = 50
			local ctrl = {f = 0, b = 0, l = 0, r = 0}
			local lastctrl = {f = 0, b = 0, l = 0, r = 0}

			UserInputService.InputBegan:Connect(function(input, gp)
				if gp then return end
				if input.KeyCode == Enum.KeyCode.W then ctrl.f = 1 end
				if input.KeyCode == Enum.KeyCode.S then ctrl.b = -1 end
				if input.KeyCode == Enum.KeyCode.A then ctrl.l = -1 end
				if input.KeyCode == Enum.KeyCode.D then ctrl.r = 1 end
			end)
			UserInputService.InputEnded:Connect(function(input, gp)
				if gp then return end
				if input.KeyCode == Enum.KeyCode.W then ctrl.f = 0 end
				if input.KeyCode == Enum.KeyCode.S then ctrl.b = 0 end
				if input.KeyCode == Enum.KeyCode.A then ctrl.l = 0 end
				if input.KeyCode == Enum.KeyCode.D then ctrl.r = 0 end
			end)

			task.spawn(function()
				while flying and char.Parent and hum.Health > 0 do
					RunService.RenderStepped:Wait()
					if ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0 then
						speed = math.min(speed + 1, maxspeed)
					else
						speed = math.max(speed - 1, 0)
					end

					if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
						bv.velocity = ((Camera.CFrame.lookVector * (ctrl.f + ctrl.b)) + ((Camera.CFrame * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * 0.2, 0).p) - Camera.CFrame.p)) * speed
						lastctrl = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
					elseif (ctrl.l + ctrl.r) == 0 and (ctrl.f + ctrl.b) == 0 and speed ~= 0 then
						bv.velocity = ((Camera.CFrame.lookVector * (lastctrl.f + lastctrl.b)) + ((Camera.CFrame * CFrame.new(lastctrl.l + lastctrl.r, (lastctrl.f + lastctrl.b) * 0.2, 0).p) - Camera.CFrame.p)) * speed
					else
						bv.velocity = Vector3.new(0, 0, 0)
					end
					bg.cframe = Camera.CFrame * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * speed / maxspeed), 0, 0)
				end
			end)
		end
	end)

