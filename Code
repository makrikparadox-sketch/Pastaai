-- ================= VISUALS =================
local espActive = false
local activeEspData = {}
local espColor = Color3.fromRGB(110, 190, 255)

local espBtn = Instance.new("TextButton", visualsPage)
espBtn.Size = UDim2.new(1, 0, 0, 40)
espBtn.BackgroundColor3 = Color3.fromRGB(30, 45, 70)
espBtn.Text = "ESP: OFF"
espBtn.TextColor3 = Color3.new(1, 1, 1)
espBtn.Position = UDim2.fromOffset(0, 0)
Instance.new("UICorner", espBtn).CornerRadius = UDim.new(0, 6)

local function createESP(p)
	if p == LP or not p.Character then return end
	local char = p.Character
	local head = char:FindFirstChild("Head")
	if not head then return end
	local hl = Instance.new("Highlight", char)
	hl.FillColor = espColor hl.OutlineColor = espColor hl.FillTransparency = 0.6
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	local bb = Instance.new("BillboardGui", char)
	bb.Adornee = head bb.Size = UDim2.new(0, 200, 0, 50) bb.StudsOffset = Vector3.new(0, 3, 0) bb.AlwaysOnTop = true
	local name = Instance.new("TextLabel", bb)
	name.Size = UDim2.new(1, 0, 0, 20) name.BackgroundTransparency = 1 name.Text = p.Name name.TextColor3 = espColor
	name.TextStrokeTransparency = 0 name.Font = Enum.Font.GothamBold name.TextSize = 14
	local dist = Instance.new("TextLabel", bb)
	dist.Size = UDim2.new(1, 0, 0, 16) dist.Position = UDim2.new(0, 0, 0, 20) dist.BackgroundTransparency = 1
	dist.TextColor3 = Color3.new(1, 1, 1) dist.TextStrokeTransparency = 0 dist.Font = Enum.Font.Gotham dist.TextSize = 12
	activeEspData[p] = {Highlight = hl, Billboard = bb, NameLabel = name, DistLabel = dist, Char = char}
end

espBtn.MouseButton1Click:Connect(function()
	espActive = not espActive
	espBtn.Text = espActive and "ESP: ON" or "ESP: OFF"
	if espActive then
		for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
	else
		for p, d in pairs(activeEspData) do
			if d.Highlight then d.Highlight:Destroy() end
			if d.Billboard then d.Billboard:Destroy() end
		end
		activeEspData = {}
	end
end)

RunService.RenderStepped:Connect(function()
	if not espActive then return end
	for p, d in pairs(activeEspData) do
		if d.Char and d.Char:FindFirstChild("HumanoidRootPart") then
			local dist = (d.Char.HumanoidRootPart.Position - workspace.CurrentCamera.CFrame.Position).Magnitude
			d.DistLabel.Text = string.format("[%d]", math.floor(dist))
		end
	end
end)

-- ================= PLAYERS =================
local selectedPlayer = nil
local playerList = Instance.new("ScrollingFrame", playersPage)
playerList.Size = UDim2.new(1, 0, 0, 150)
playerList.BackgroundTransparency = 1
playerList.ScrollBarThickness = 3
playerList.AutomaticCanvasSize = Enum.AutomaticSize.Y
local listLayout = Instance.new("UIListLayout", playerList)
listLayout.Padding = UDim.new(0, 5)

local function refreshList()
	for _, v in ipairs(playerList:GetChildren()) do
		if v:IsA("TextButton") then v:Destroy() end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local btn = Instance.new("TextButton", playerList)
			btn.Size = UDim2.new(1, 0, 0, 35)
			btn.BackgroundColor3 = (p == selectedPlayer) and Color3.fromRGB(110, 190, 255) or Color3.fromRGB(30, 45, 70)
			btn.Text = p.Name
			btn.TextColor3 = Color3.new(1, 1, 1)
			btn.Font = Enum.Font.GothamBold
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
			btn.MouseButton1Click:Connect(function()
				selectedPlayer = p
				refreshList()
			end)
		end
	end
end

