	local function removeESP(p)
		local d = ESP.Data[p]
		if not d then return end
		pcall(function() d.Highlight:Destroy() end)
		pcall(function() d.Billboard:Destroy() end)
		ESP.Data[p] = nil
	end

	local function hookPlayer(p)
		createESP(p)
		p.CharacterAdded:Connect(function()
			task.wait(0.6)
			removeESP(p)
			createESP(p)
		end)
	end

	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
	Players.PlayerRemoving:Connect(removeESP)

	RunService.RenderStepped:Connect(function()
		for p, d in pairs(ESP.Data) do
			local char = p.Character
			local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if not ESP.Enabled or not char or not root or not hum or hum.Health <= 0 or isTeammate(p) then
				pcall(function() d.Highlight.Enabled = false end)
				pcall(function() d.Billboard.Enabled = false end)
				continue
			end

			local dist = (root.Position - Camera.CFrame.Position).Magnitude
			if dist > ESP.MaxDistance then
				pcall(function() d.Highlight.Enabled = false end)
				pcall(function() d.Billboard.Enabled = false end)
				continue
			end

			pcall(function() d.Highlight.Enabled = ESP.ShowChams end)
			pcall(function() d.Billboard.Enabled = true end)

			pcall(function()
				d.NameLabel.Visible = ESP.ShowName
				d.DistLabel.Visible = ESP.ShowDistance
				d.DistLabel.Text = string.format("[%d]", math.floor(dist))
				d.HPBg.Visible = ESP.ShowHealth
				local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
				d.HPBar.Size = UDim2.new(hp, 0, 1, 0)
				d.HPBar.BackgroundColor3 = Color3.fromHSV(hp * 0.3, 1, 1)
			end)
		end
	end)

