	local function teleportTo(target)
		if not target or not target.Character then
			print("[] Телепорт: у игрока нет персонажа")
			return
		end
		local targetRoot = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Torso")
		local myChar = LocalPlayer.Character
		local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
		if not targetRoot or not myRoot then
			print("[] Телепорт: не найден HumanoidRootPart")
			return
		end
		myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
		print("[] Телепорт к: " .. target.Name)
	end

	local function refreshPlayerList()
		if not PlayerListFrame then return end
		for _, b in ipairs(PlayerButtons) do b:Destroy() end
		PlayerButtons = {}

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1, -6, 0, 44)
				b.BackgroundColor3 = (p == SelectedPlayer) and ACCENT or Color3.fromRGB(15, 30, 70)
				b.BackgroundTransparency = (p == SelectedPlayer) and 0.2 or 0.35
				b.Text = p.Name
				b.Font = Enum.Font.GothamBold
				b.TextSize = 15
				b.TextColor3 = Color3.new(1, 1, 1)
				b.ZIndex = 4
				b.Parent = PlayerListFrame
				corner(b, UDim.new(0, 12))
				stroke(b, Color3.new(1, 1, 1), 1, 0.85)

				b.MouseButton1Click:Connect(function()
					if SelectedPlayer == p then
						SelectedPlayer = nil
					else
						SelectedPlayer = p
					end
					refreshPlayerList()
				end)
				table.insert(PlayerButtons, b)
			end
		end

		if #PlayerButtons == 0 then
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, -6, 0, 44)
			lbl.BackgroundColor3 = Color3.fromRGB(15, 30, 70)
			lbl.BackgroundTransparency = 0.35
			lbl.Text = "Игроков нет"
			lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
			lbl.Font = Enum.Font.GothamMedium
			lbl.TextSize = 14
			lbl.ZIndex = 4
			lbl.Parent = PlayerListFrame
			corner(lbl, UDim.new(0, 12))
			table.insert(PlayerButtons, lbl)
		end
	end

