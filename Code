local function createESP(p)
	if p == LP or not p.Character then return end
	local char = p.Character
	local head = char:FindFirstChild("Head")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not head or not hum then return end
	local hl = Instance.new("Highlight", char)
	hl.FillColor = espColor hl.OutlineColor = espColor hl.FillTransparency = 0.6
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled = showChams
	local bb = Instance.new("BillboardGui", char)
	bb.Adornee = head bb.Size = UDim2.new(0, 200, 0, 80) bb.StudsOffset = Vector3.new(0, 3, 0) bb.AlwaysOnTop = true
	local name = Instance.new("TextLabel", bb) name.Size = UDim2.new(1, 0, 0, 20) name.BackgroundTransparency = 1 name.Text = p.Name name.TextColor3 = espColor name.TextStrokeTransparency = 0 name.Font = Enum.Font.GothamBold name.TextSize = 14 name.Visible = showName
	local dist = Instance.new("TextLabel", bb) dist.Size = UDim2.new(1, 0, 0, 16) dist.Position = UDim2.new(0, 0, 0, 20) dist.BackgroundTransparency = 1 dist.TextColor3 = Color3.new(1, 1, 1) dist.TextStrokeTransparency = 0 dist.Font = Enum.Font.Gotham dist.TextSize = 12 dist.Visible = showDist
	local hpText = Instance.new("TextLabel", bb) hpText.Size = UDim2.new(1, 0, 0, 16) hpText.Position = UDim2.new(0, 0, 0, 36) hpText.BackgroundTransparency = 1 hpText.TextColor3 = Color3.fromRGB(0, 255, 0) hpText.TextStrokeTransparency = 0 hpText.Font = Enum.Font.Gotham hpText.TextSize = 12 hpText.Text = "HP: 100" hpText.Visible = showHealth
	activeEspData[p] = {Highlight = hl, Billboard = bb, NameLabel = name, DistLabel = dist, HealthLabel = hpText, Char = char}
end

local function removeESP(p)
	local d = activeEspData[p]
	if d then
		if d.Highlight then d.Highlight:Destroy() end
		if d.Billboard then d.Billboard:Destroy() end
		activeEspData[p] = nil
	end
end

