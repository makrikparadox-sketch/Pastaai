		track.ZIndex = 5
		track.Parent = row
		corner(track, UDim.new(1, 0))

		local fill = Instance.new("Frame")
		fill.BackgroundColor3 = ACCENT
		fill.ZIndex = 6
		fill.Parent = track
		corner(fill, UDim.new(1, 0))

		local knob = Instance.new("Frame")
		knob.Size = UDim2.fromOffset(16, 16)
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.BackgroundColor3 = Color3.new(1, 1, 1)
		knob.ZIndex = 7
		knob.Parent = track
		corner(knob, UDim.new(1, 0))

		local hit = Instance.new("TextButton")
		hit.Size = UDim2.new(1, 0, 0, 28)
		hit.Position = UDim2.fromOffset(0, 30)
		hit.BackgroundTransparency = 1
		hit.Text = ""
		hit.ZIndex = 8
		hit.Parent = row

		local function setAlpha(a)
			a = math.clamp(a, 0, 1)
			local value = math.floor(min + (max - min) * a + 0.5)
			fill.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.new(a, 0, 0.5, 0)
			valLbl.Text = tostring(value)
			if callback then task.spawn(callback, value) end
		end
		local function fromInput(input)
			setAlpha((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
		end

		local sliding = false
		hit.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				fromInput(i)
			end
		end)
		UserInputService.InputChanged:Connect(function(i)
			if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				fromInput(i)
			end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end)

		setAlpha((default - min) / (max - min))
	end

