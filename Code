local pages = {}
local function createPage(name)
	local btn = Instance.new("TextButton", tabBar)
	btn.Size = UDim2.new(0.3, 0, 0, 30)
	btn.BackgroundColor3 = Color3.fromRGB(110, 190, 255)
	btn.Text = name
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	
	local page = Instance.new("Frame", menu)
	page.Size = UDim2.new(1, -20, 1, -60)
	page.Position = UDim2.fromOffset(10, 50)
	page.BackgroundTransparency = 1
	page.Visible = false
	
	pages[name] = {Page = page, Button = btn}
	btn.MouseButton1Click:Connect(function()
		for n, p in pairs(pages) do
			p.Page.Visible = (n == name)
			p.Button.BackgroundColor3 = (n == name) and Color3.fromRGB(110, 190, 255) or Color3.fromRGB(30, 45, 70)
		end
	end)
	return page
end

