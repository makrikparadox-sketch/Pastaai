		local fill = Instance.new("Frame", track)
		fill.BackgroundColor3 = ACCENT
		fill.ZIndex = 6
		corner(fill, UDim.new(1, 0))

		local knob = Instance.new("Frame", track)
		knob.Size = UDim2.fromOffset(16, 16)
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.BackgroundColor3 = Color3.new(1, 1, 1)
		knob.ZIndex = 7
		corner(knob, UDim.new(1, 0))

		local hit = Instance.new("TextButton", row)
		hit.Size = UDim2.new(1, 0, 0, 28)
		hit.Position = UDim2.fromOffset(0, 30)
		hit.BackgroundTransparency = 1
		hit.Text = ""
		hit.ZIndex = 8

		local function setAlpha(a)
			a = math.clamp(a, 0, 1)
			local value = math.floor(min + (max - min) * a + 0.5)
			fill.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.new(a, 0, 0.5, 0)
			valLbl.Text = tostring(value)
			if callback then task.spawn(callback, value) end
		end
		local function fromInput(input)
			setAlpha((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
		end

		local sliding = false
		hit.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				fromInput(i)
			end
		end)
		UserInputService.InputChanged:Connect(function(i)
			if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				fromInput(i)
			end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end)

		setAlpha((default - min) / (max - min))
	end

	-- ESP ЛОГИКА
	local ESP = { Enabled = false, ShowChams = true, ShowName = true, ShowDistance = true, MaxDistance = 500, Data = {} }
	local Camera = Workspace.CurrentCamera

	local function isTeammate(p)
		if not p.Team or not LP.Team then return false end
		return p.Team == LP.Team
	end

	local function createESP(p)
		if p == LP then return end
		if ESP.Data[p] then return end
		local char = p.Character
		if not char then return end
		local head = char:FindFirstChild("Head")
		if not head then return end

		local highlight = Instance.new("Highlight", char)
		highlight.Adornee = char
		highlight.FillColor = ACCENT
		highlight.FillTransparency = 0.55
		highlight.OutlineColor = ACCENT
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Enabled = false

		local billboard = Instance.new("BillboardGui", char)
		billboard.Adornee = head
		billboard.Size = UDim2.new(0, 200, 0, 60)
		billboard.StudsOffset = Vector3.new(0, 3.2, 0)
		billboard.AlwaysOnTop = true
		billboard.Enabled = false

		local nameLabel = Instance.new("TextLabel", billboard)
		nameLabel.Size = UDim2.new(1, 0, 0, 20)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = p.Name
		nameLabel.TextColor3 = Color3.new(1, 1, 1)
		nameLabel.TextStrokeTransparency = 0
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 14

		local distLabel = Instance.new("TextLabel", billboard)
		distLabel.Size = UDim2.new(1, 0, 0, 16)
		distLabel.Position = UDim2.new(0, 0, 0, 20)
		distLabel.BackgroundTransparency = 1
		distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
		distLabel.TextStrokeTransparency = 0
		distLabel.Font = Enum.Font.Gotham
		distLabel.TextSize = 12

		ESP.Data[p] = { H = highlight, B = billboard, N = nameLabel, D = distLabel }
	end

	local function removeESP(p)
		local d = ESP.Data[p]
		if not d then return end
		pcall(function() d.H:Destroy() end)
		pcall(function() d.B:Destroy() end)
		ESP.Data[p] = nil
	end

	local function hookPlayer(p)
		createESP(p)
		p.CharacterAdded:Connect(function()
			task.wait(0.6)
			removeESP(p)
			createESP(p)
		end)
	end

	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
	Players.PlayerRemoving:Connect(removeESP)

	RunService.RenderStepped:Connect(function()
		for p, d in pairs(ESP.Data) do
			local char = p.Character
			local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if not ESP.Enabled or not char or not root or not hum or hum.Health <= 0 or isTeammate(p) then
				pcall(function() d.H.Enabled = false; d.B.Enabled = false end)
				continue
			end

			local dist = (root.Position - Camera.CFrame.Position).Magnitude
			if dist > ESP.MaxDistance then
				pcall(function() d.H.Enabled = false; d.B.Enabled = false end)
				continue
			end

			pcall(function()
				d.H.Enabled = ESP.ShowChams
				d.B.Enabled = true
				d.N.Visible = ESP.ShowName
				d.D.Visible = ESP.ShowDistance
				d.D.Text = string.format("[%d]", math.floor(dist))
			end)
		end
	end)

	-- ТЕЛЕПОРТ
	local SelectedPlayer = nil
	local PlayerListFrame = nil
	local PlayerButtons = {}

	local function teleportTo(target)
		if not target or not target.Character then return end
		local tRoot = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Torso")
		local myChar = LP.Character
		local mRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
		if tRoot and mRoot then
			mRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
		end
	end

	local function refreshPlayerList()
		if not PlayerListFrame then return end
		for _, b in ipairs(PlayerButtons) do b:Destroy() end
		PlayerButtons = {}

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP then
				local b = Instance.new("TextButton", PlayerListFrame)
				b.Size = UDim2.new(1, -6, 0, 44)
				b.BackgroundColor3 = (p == SelectedPlayer) and ACCENT or Color3.fromRGB(15, 30, 70)
				b.Text = p.Name
				b.Font = Enum.Font.GothamBold
				b.TextSize = 15
				b.TextColor3 = Color3.new(1, 1, 1)
				b.ZIndex = 4
				corner(b, UDim.new(0, 12))

				b.MouseButton1Click:Connect(function()
					SelectedPlayer = (SelectedPlayer == p) and nil or p
					refreshPlayerList()
				end)
				table.insert(PlayerButtons, b)
			end
		end
	end

