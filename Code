local flying = false
local flySpeed = 50
addToggle(movementPage, "Fly", function(on)
	flying = on
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end
	if flying then
		hum.PlatformStand = true
		local bv = Instance.new("BodyVelocity", root) bv.MaxForce = Vector3.new(9e9, 9e9, 9e9) bv.Velocity = Vector3.zero
		local bg = Instance.new("BodyGyro", root) bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9) bg.P = 10000
		local keys = {f=0,b=0,l=0,r=0,up=0,dn=0}
		UIS.InputBegan:Connect(function(i, g) if g then return end
			if i.KeyCode == Enum.KeyCode.W then keys.f=1 end if i.KeyCode == Enum.KeyCode.S then keys.b=-1 end
			if i.KeyCode == Enum.KeyCode.A then keys.l=-1 end if i.KeyCode == Enum.KeyCode.D then keys.r=1 end
			if i.KeyCode == Enum.KeyCode.Space then keys.up=1 end if i.KeyCode == Enum.KeyCode.LeftShift then keys.dn=-1 end
		end)
		UIS.InputEnded:Connect(function(i)
			if i.KeyCode == Enum.KeyCode.W then keys.f=0 end if i.KeyCode == Enum.KeyCode.S then keys.b=0 end
			if i.KeyCode == Enum.KeyCode.A then keys.l=0 end if i.KeyCode == Enum.KeyCode.D then keys.r=0 end
			if i.KeyCode == Enum.KeyCode.Space then keys.up=0 end if i.KeyCode == Enum.KeyCode.LeftShift then keys.dn=0 end
		end)
		task.spawn(function()
			while flying and char.Parent do
				RunService.RenderStepped:Wait()
				local cam = Camera.CFrame
				bg.CFrame = CFrame.new(root.Position, root.Position + cam.LookVector)
				local moveDir = hum.MoveDirection
				local finalDir = Vector3.zero
				if moveDir.Magnitude > 0 then
					local forward = cam.LookVector * (moveDir.Z * -1)
					local right = cam.RightVector * moveDir.X
					finalDir = (forward + right).Unit * flySpeed
				else
					local forward = cam.LookVector * keys.f
					local backward = cam.LookVector * keys.b
					local left = cam.RightVector * keys.l
					local right = cam.RightVector * keys.r
					local up = Vector3.new(0, 1, 0) * keys.up
					local down = Vector3.new(0, 1, 0) * keys.dn
					local manualDir = forward + backward + left + right + up + down
					if manualDir.Magnitude > 0 then finalDir = manualDir.Unit * flySpeed end
				end
				bv.Velocity = finalDir
			end
		end)
	else
		hum.PlatformStand = false
		local bv = root:FindFirstChildOfClass("BodyVelocity") if bv then bv:Destroy() end
		local bg = root:FindFirstChildOfClass("BodyGyro") if bg then bg:Destroy() end
	end
end)
